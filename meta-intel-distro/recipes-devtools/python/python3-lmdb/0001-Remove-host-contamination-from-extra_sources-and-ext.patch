From a17348fbce0785db0e428c32140380e1a69d13e4 Mon Sep 17 00:00:00 2001
From: Daniel Dragomir <daniel.dragomir@windriver.com>
Date: Fri, 13 Mar 2026 02:17:35 +0200
Subject: [PATCH] Remove host contamination from extra_sources and
 extra_include_dirs

The build records absolute paths (based on the setup.py directory) into
lmdb/_config.py for extra_sources, extra_include_dirs and the per-engine
specs. In a Yocto build these resolve under TMPDIR and trigger the
buildpaths QA issue:

WARNING: python3-lmdb do_package_qa: QA Issue:
File /usr/lib64/python3.12/site-packages/lmdb/_config.py
in package python3-lmdb contains reference to TMPDIR
File /usr/lib64/python3.12/site-packages/lmdb/__pycache__/_config.cpython-312.pyc
in package python3-lmdb contains reference to TMPDIR [buildpaths]

Use a relative base directory so the paths recorded in _config.py stay
relative to the source tree.

Upstream-Status: Inappropriate
---
 setup.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/setup.py b/setup.py
index 1aedbc3..3391b08 100644
--- a/setup.py
+++ b/setup.py
@@ -72,7 +72,7 @@ extra_compile_args = []
 # the working directory.  cffi's verify() builds from its own temporary
 # directory on some implementations (notably PyPy), where relative source
 # paths would not resolve.
-HERE = os.path.dirname(os.path.abspath(__file__))
+HERE = os.path.relpath(os.path.dirname(os.path.abspath(__file__)))
 
 extra_include_dirs += [os.path.join(HERE, 'lib', 'py-lmdb'),
                        os.path.join(HERE, 'lmdb')]
